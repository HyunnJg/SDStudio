  "build": {
    "productName": "SDStudio-HyunnJg",
    "executableName": "sdstudio-hyunnjg",
    "appId": "io.github.hyunnjg.sdstudio",
    "asar": true,
    "asarUnpack": [
      "**\\*.{node,dll}",
      "**/node_modules/sharp/**/*",
      "**/node_modules/sdsnative/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/chokidar/**/*",
      "**/node_modules/exiftool-vendored/**/*",
      "**/node_modules/exiftool-vendored.*/**/*",
      "**/node_modules/fsevents/**/*",
      "**/localai/**/*"
    ],
    "files": [
      "dist",
      "node_modules",
      "package.json",
      "data",
      "localai",
      "!node_modules/sdsnative/db.csv",
      "!node_modules/sdsnative/test.js",
      "!node_modules/batch-cluster/types/chai-withintoleranceof/**/*"
    ],
    "beforePack": ".erb/scripts/collect-bundle-notices.cjs",
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "mergeASARs": false,
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "singleArchFiles": "**/sharp-darwin-arm64v8.node",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      {
        "from": "LICENSES/electron-react-boilerplate.txt",
        "to": "LICENSES/electron-react-boilerplate.txt"
      },
      {
        "from": "LICENSES/tagcomplete-MIT.txt",
        "to": "LICENSES/tagcomplete-MIT.txt"
      },
      {
        "from": "CREDITS.md",
        "to": "CREDITS.md"
      },
      {
        "from": ".erb/generated/notices",
        "to": "THIRD_PARTY_NOTICES",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "HyunnJg",
      "repo": "SDStudio",
      "releaseType": "draft"
    }
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11.21.3 <12"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**"
    ],
    "logLevel": "quiet"
  },
  "extraMetadata": {
    "version": "1.0.0"
  },
  "packageManager": "npm@11.21.3",
  "overrides": {
    "node-gyp": "12.2.0"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "electron-winstaller": false,
    "esbuild": false,
    "exifreader": false,
    "protobufjs": false,
    "swiftlint": false
  }
}
