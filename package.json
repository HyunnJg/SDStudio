    "libsodium-wrappers-sumo": "0.7.13",
    "memoize-one": "^6.0.0",
    "mobile-drag-drop": "^v2.3.0-rc.2",
    "mobx-react-lite": "^4.0.7",
    "mobx-state-tree": "^6.0.1",
    "nan": "^2.20.0",
    "nightwind": "^1.1.13",
    "node-fetch": "^3.3.2",
