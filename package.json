{
  "name": "sdstudio-hyunnjg",
  "description": "NovelAI 이미지 생성과 씬별 반복 촬영·선별을 위한 데스크톱 작업실",
  "keywords": [
    "electron",
    "boilerplate",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "license": "MIT",
  "author": {
    "name": "sunho",
    "email": "ksunhokim123@gmail.com",
    "url": "https://sunho.io"
  },
  "main": "./.erb/scripts/start-main.cjs",
  "version": "3.1.12-rc.1",
  "scripts": {
    "smoke:auth-ui": "node .erb/scripts/smoke-auth-ui.cjs",
    "smoke:package": "node .erb/scripts/smoke-package.cjs",
    "package:manifest": "node .erb/scripts/inspect-package.cjs",
    "test:network-mode": "node --test -r ts-node/register/transpile-only src/__tests__/networkMode.test.cjs",
    "smoke:network-mode": "node .erb/scripts/smoke-network-mode.cjs",
    "test:identity": "node --test -r ts-node/register/transpile-only src/__tests__/forkIdentity.test.cjs",
    "test:auth-ui": "node --test -r ts-node/register/transpile-only src/__tests__/naiAuthUi.test.cjs",
    "test:nai-main": "node --test -r ts-node/register/transpile-only src/__tests__/naiAuth.test.cjs src/__tests__/naiTransport.test.cjs src/__tests__/naiMediaType.test.cjs",
    "test:nai-main:electron": "node --test src/__tests__/naiMain.electron.cjs",
    "test:bundle-notices": "node --test src/__tests__/bundleNotices.test.cjs",
    "package:check-notices": "node .erb/scripts/check-package-notices.cjs",
    "licenses:bundle": "node .erb/scripts/collect-bundle-notices.cjs",
    "test:licenses": "python3 src/__tests__/licenseEvidence.test.py",
    "licenses:evidence": "python3 .erb/scripts/collect-license-evidence.py --installed",
    "profile:check": "node .erb/scripts/isolated-profile.cjs check",
    "start:isolated": "node .erb/scripts/isolated-profile.cjs start",
    "test:profile": "node --test -r ts-node/register/transpile-only src/__tests__/developmentProfile.test.cjs",
    "test:profile:electron": "node --test src/__tests__/developmentProfile.electron.cjs",
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\" && npm run licenses:bundle",
    "build:dll": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "preinstall": "node .erb/scripts/check-toolchain.cjs",
    "postinstall": "node .erb/scripts/setup-desktop.cjs",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package-corss": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -w --x64 --publish never && npm run build:dll",
    "package": "cross-env ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never && npm run build:dll",
    "rebuild": "node .erb/scripts/setup-desktop.cjs --rebuild-only",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electronmon .",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,md}\"",
    "test:offline": "node --test -r ts-node/register/transpile-only src/__tests__/offlineRuntime.test.cjs",
    "start:mock": "cross-env SDSTUDIO_MOCK_BACKEND=1 npm run start:renderer",
    "smoke:offline": "node .erb/scripts/smoke-offline.cjs",
    "test:startup": "node --test -r ts-node/register/transpile-only src/__tests__/desktopStartup.test.cjs",
    "test:startup:electron": "node --test src/__tests__/desktopStartup.electron.cjs",
    "test:nai-contract": "node --test -r ts-node/register/transpile-only src/__tests__/naiPreviewContract.test.cjs",
    "test:workspace": "node --test -r ts-node/register/transpile-only src/__tests__/workspaceDraft.test.cjs src/__tests__/workspaceQueue.test.cjs",
    "smoke:workspace": "cross-env SDSTUDIO_SMOKE_WORKSPACE=1 npm run smoke:offline",
    "start:preview": "cross-env SDSTUDIO_MOCK_BACKEND=1 npm run start:isolated",
    "nai:validate-live": "node .erb/scripts/nai-validate-live.cjs",
    "test:nai-live:electron": "node --test src/__tests__/naiLiveValidation.electron.cjs",
    "test:nai-live": "node --test -r ts-node/register/transpile-only src/__tests__/naiLiveValidation.test.cjs",
    "nai:inspect-response": "node .erb/scripts/inspect-nai-response.cjs",
    "test:nai-response": "node --test -r ts-node/register/transpile-only src/__tests__/naiImageResponse.test.cjs src/__tests__/naiResponseInspection.test.cjs",
    "test:project": "node --test -r ts-node/register/transpile-only src/__tests__/workspaceProject.test.cjs",
    "test:project:electron": "node --test src/__tests__/workspaceProject.electron.cjs",
    "test:project-ui": "node --test -r ts-node/register/transpile-only src/__tests__/projectController.test.cjs src/__tests__/projectService.test.cjs",
    "smoke:project-ui": "node .erb/scripts/smoke-project-ui.cjs",
    "test:generation-v5": "node --test -r ts-node/register/transpile-only src/__tests__/v5Generation.test.cjs",
    "test:generation": "node --test -r ts-node/register/transpile-only src/__tests__/workspaceGeneration.test.cjs",
    "smoke:generation-characters": "node .erb/scripts/smoke-generation.cjs characters",
    "test:reference": "node --test -r ts-node/register/transpile-only src/__tests__/workspaceReference.test.cjs src/__tests__/workspaceReferenceUi.test.cjs",
    "smoke:trash": "node .erb/scripts/smoke-generation.cjs trash",
    "smoke:inpaint": "node .erb/scripts/smoke-generation.cjs inpaint",
    "smoke:legacy-writer": "node .erb/scripts/smoke-generation.cjs legacy-writer",
    "smoke:reference": "node .erb/scripts/smoke-generation.cjs reference",
    "smoke:generation": "node .erb/scripts/smoke-generation.cjs",
    "test:project-reads": "node --test -r ts-node/register/transpile-only src/__tests__/projectReads.test.cjs",
    "test:generation-queue": "node --test -r ts-node/register/transpile-only src/__tests__/generationQueue.test.cjs src/__tests__/generationPresentation.test.cjs",
    "smoke:generation-queue": "node .erb/scripts/smoke-generation.cjs queue",
    "smoke:generation-errors": "node .erb/scripts/smoke-generation.cjs queue-errors",
    "setup:desktop": "node .erb/scripts/setup-desktop.cjs",
    "verify:desktop": "node .erb/scripts/verify-desktop.cjs",
    "test:runtime": "node --test src/__tests__/runtimeToolchain.test.cjs",
    "test:unit": "node --test --test-concurrency=4 -r ts-node/register/transpile-only src/__tests__/*.test.cjs",
    "test:async-storage:electron": "node --test src/__tests__/asyncStorage.electron.cjs"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@anuradev/capacitor-background-mode": "file:externals/capacitor-background-mode",
    "@capacitor-community/file-opener": "^6.0.0",
